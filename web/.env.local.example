# Copy this file to .env.local (gitignored) and fill in real values.
# Same Supabase project as the Android app - Dashboard -> Project Settings -> API.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Dashboard -> Project Settings -> API -> "service_role" secret. Server-only, bypasses RLS -
# only used by the Stripe webhook. NEVER prefix with NEXT_PUBLIC_, never send to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-SECRET-KEY

# Stripe Dashboard -> Developers -> API keys.
STRIPE_SECRET_KEY=sk_test_...
# Stripe Dashboard -> Product catalog -> the one-time "Ativação de igreja" price's ID.
STRIPE_PRICE_ID=price_...
# Stripe Dashboard -> Developers -> Webhooks -> your endpoint -> Signing secret.
STRIPE_WEBHOOK_SECRET=whsec_...
